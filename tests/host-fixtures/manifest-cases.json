{
  "description": "Shared host-contract fixtures. Each case mutates the base manifest in valid.json and lists the validation error codes (prefix match) that scripts/validate-hosts.mjs must raise. Adding a new host never requires touching Hosted MCP business code; these cases pin the manifest contract itself.",
  "base": "valid.json",
  "cases": [
    {
      "name": "missing minVersion is rejected",
      "delete": ["hosts.0.minVersion"],
      "expect": ["manifest:missing-field:example-host.minVersion"]
    },
    {
      "name": "unknown tier is rejected",
      "set": { "hosts.0.tier": "D" },
      "expect": ["manifest:enum:example-host.tier:D"]
    },
    {
      "name": "duplicate host ids are rejected",
      "set": { "hosts.1.id": "example-host" },
      "expect": ["manifest:duplicate-id:example-host"]
    },
    {
      "name": "hosts must cite at least one https source",
      "set": { "hosts.0.sources": [] },
      "expect": ["manifest:sources:example-host"]
    },
    {
      "name": "exactly one generic fallback entry",
      "set": { "hosts.0.kind": "generic" },
      "expect": ["manifest:generic-count"]
    },
    {
      "name": "canonical endpoint variable is fixed",
      "set": { "canonical.endpointVariable": "SOME_OTHER_URL" },
      "expect": ["manifest:canonical:endpointVariable"]
    },
    {
      "name": "protocol era values are constrained",
      "set": { "hosts.0.mcp.protocolEras.2026-07-28": "yes" },
      "expect": ["manifest:enum:example-host.mcp.protocolEras.2026-07-28:yes"]
    },
    {
      "name": "draft accept/drop can never be advertised",
      "set": { "canonical.draftAcceptDrop": true },
      "expect": ["manifest:canonical:draftAcceptDrop"]
    },
    {
      "name": "clientInfo stays analytics-only",
      "set": { "canonical.clientInfoUsage": "authorization-dimension" },
      "expect": ["manifest:canonical:clientInfoUsage"]
    },
    {
      "name": "lifecycle commands are required",
      "delete": ["hosts.0.lifecycle.uninstall"],
      "expect": ["manifest:missing-field:example-host.lifecycle.uninstall"]
    }
  ]
}
