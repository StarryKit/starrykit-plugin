{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starrykit.com/schemas/starrykit-agent-plugin/hosts/compatibility.schema.json",
  "title": "StarryKit Agent Plugin host compatibility manifest",
  "description": "Machine-readable host support matrix for the StarryKit Agent Plugin. Consumed by host READMEs and the Marketing support matrix. Hosts never fork business semantics: one canonical SKILL.md, one Hosted MCP endpoint, one OAuth flow.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "updated", "canonical", "tiers", "hosts"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date (UTC) this manifest was last reviewed against host documentation."
    },
    "canonical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skillPath",
        "endpointVariable",
        "transport",
        "protocolEras",
        "oauth",
        "draftAcceptDrop",
        "clientInfoUsage"
      ],
      "properties": {
        "skillPath": {
          "const": "skills/starrykit-authoring/SKILL.md",
          "description": "The single source of truth for workflow and safety semantics. Host adapters reference it and never copy it."
        },
        "endpointVariable": {
          "const": "STARRYKIT_MCP_URL",
          "description": "Environment variable name available to command-oriented adapters when they need to reference the canonical Production Hosted MCP endpoint."
        },
        "transport": { "const": "streamable-http" },
        "protocolEras": {
          "type": "object",
          "additionalProperties": false,
          "required": ["2025-06-18", "2026-07-28"],
          "properties": {
            "2025-06-18": { "$ref": "#/$defs/serverEraStatus" },
            "2026-07-28": { "$ref": "#/$defs/serverEraStatus" }
          },
          "description": "What the Hosted MCP server itself speaks today. The 2026-07-28 stateless upgrade is tracked separately and flips this field when it ships."
        },
        "oauth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "grantTypes",
            "pkce",
            "dynamicClientRegistration",
            "scopes",
            "resourceMetadataPath"
          ],
          "properties": {
            "grantTypes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "pkce": { "type": "array", "items": { "const": "S256" }, "minItems": 1 },
            "dynamicClientRegistration": {
              "enum": ["unauthenticated", "authenticated", "none"],
              "description": "RFC 7591 support on the StarryKit authorization server."
            },
            "scopes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "resourceMetadataPath": {
              "const": "/.well-known/oauth-protected-resource/mcp",
              "description": "RFC 9728 protected resource metadata, relative to the MCP origin."
            }
          }
        },
        "draftAcceptDrop": {
          "const": false,
          "description": "MCP never exposes Page Draft accept/drop; users decide in the StarryKit UI."
        },
        "clientInfoUsage": {
          "const": "best-effort-analytics-only",
          "description": "clientInfo is a best-effort analytics dimension. It never participates in permissions, Document Origin, or idempotency identity."
        }
      }
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B", "C"],
      "properties": {
        "A": { "type": "string" },
        "B": { "type": "string" },
        "C": { "type": "string" }
      }
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/host" }
    }
  },
  "$defs": {
    "serverEraStatus": { "enum": ["supported", "planned", "none"] },
    "hostEraStatus": {
      "enum": ["verified", "documented", "unknown", "unsupported"],
      "description": "verified = proven against a real host session; documented = official host documentation claims it; unknown = no conclusive evidence; unsupported = documented as absent."
    },
    "evidence": {
      "enum": ["verified", "documented", "unknown", "unsupported"]
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "kind",
        "tier",
        "status",
        "verification",
        "adapterPath",
        "minVersion",
        "skill",
        "mcp",
        "lifecycle",
        "limitations",
        "sources"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "displayName": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["named", "generic"],
          "description": "named = a concrete host product; generic = the manual fallback package for other compatible agents."
        },
        "tier": { "enum": ["A", "B", "C"] },
        "status": {
          "enum": ["shipped", "adapter-ready", "planned", "manual"],
          "description": "shipped = adapter published and in use; adapter-ready = adapter exists in-repo, real-host dogfood pending; planned = adapter not yet delivered; manual = documented manual integration only."
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stageDogfood", "trackingIssue"],
          "properties": {
            "stageDogfood": { "enum": ["passed", "pending", "not-applicable"] },
            "trackingIssue": { "type": "integer", "minimum": 1 }
          }
        },
        "adapterPath": {
          "type": "string",
          "minLength": 1,
          "description": "Repo-relative directory (from the plugin root) holding this host's adapter and README."
        },
        "minVersion": {
          "type": "string",
          "minLength": 1,
          "description": "Minimum host version for the documented capabilities, or \"unknown\" when the vendor does not state one."
        },
        "skill": {
          "type": "object",
          "additionalProperties": false,
          "required": ["discovery", "installScopes", "installPaths"],
          "properties": {
            "discovery": {
              "enum": ["native-agent-skills", "rules-reference", "none"],
              "description": "native-agent-skills = host natively loads SKILL.md; rules-reference = host only supports rules/AGENTS-style instructions referencing the canonical skill."
            },
            "installScopes": {
              "type": "array",
              "items": { "enum": ["project", "user", "managed", "package"] },
              "minItems": 0
            },
            "installPaths": { "type": "array", "items": { "type": "string" } }
          }
        },
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["connection", "transports", "protocolEras", "oauth", "tokenStorage"],
          "properties": {
            "connection": {
              "enum": ["native-remote", "adapter-required", "manual"],
              "description": "native-remote = host ships a remote Streamable HTTP MCP client; adapter-required = a maintained host extension must bridge MCP; manual = user wires any standard MCP client by hand."
            },
            "transports": { "type": "array", "items": { "type": "string" } },
            "protocolEras": {
              "type": "object",
              "additionalProperties": false,
              "required": ["2025-06-18", "2026-07-28"],
              "properties": {
                "2025-06-18": { "$ref": "#/$defs/hostEraStatus" },
                "2026-07-28": { "$ref": "#/$defs/hostEraStatus" }
              }
            },
            "oauth": {
              "type": "object",
              "additionalProperties": false,
              "required": ["flow", "dynamicClientRegistration", "pkce"],
              "properties": {
                "flow": {
                  "enum": [
                    "authorization-code-pkce",
                    "authorization-code",
                    "adapter-defined",
                    "manual",
                    "unknown",
                    "none"
                  ]
                },
                "dynamicClientRegistration": { "$ref": "#/$defs/evidence" },
                "pkce": { "$ref": "#/$defs/evidence" }
              }
            },
            "tokenStorage": {
              "type": "string",
              "minLength": 1,
              "description": "Where the host persists OAuth tokens, or \"unknown\" when undocumented."
            }
          }
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["install", "login", "update", "uninstall"],
          "properties": {
            "install": { "type": "string", "minLength": 1 },
            "login": { "type": "string", "minLength": 1 },
            "update": { "type": "string", "minLength": 1 },
            "uninstall": { "type": "string", "minLength": 1 }
          }
        },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^https://" }
        }
      }
    }
  }
}
